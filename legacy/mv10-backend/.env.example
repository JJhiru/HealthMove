# ============================================================
#  Variables de entorno — COPIA este archivo como .env
#  (el .env real NUNCA se sube a GitHub; ya está en .gitignore)
# ============================================================

# Cadena de conexión a PostgreSQL.
# En LOCAL: la de tu Postgres.
# En RAILWAY: se inyecta sola si referencias la variable del plugin
#   Postgres con  ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://usuario:password@localhost:5432/ef_rutinas

# SSL de la base de datos.
#   local  -> false
#   Railway (conexión pública) -> true
PGSSL=false

# Clave secreta para firmar los tokens de login (JWT).
# Cámbiala por una cadena larga y aleatoria. NO la compartas.
JWT_SECRET=pon-aqui-una-cadena-larga-aleatoria-y-secreta

# Puerto local. En Railway lo asigna la plataforma automáticamente.
PORT=3000
